APP_ENV=development
APP_NAME=Sherlock
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
DATABASE_URL=postgresql+psycopg://sherlock_admin:change_me@localhost:5432/sherlock_db
READONLY_DATABASE_URL=postgresql+psycopg://sherlock_readonly:change_me@localhost:5432/sherlock_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://your-clerk-frontend-api/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Optional local alternative to CLERK_JWKS_URL. Paste Clerk's JWT verification key only in apps/api/.env.
CLERK_JWT_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=
