APP_ENV=production
APP_NAME=Sherlock
API_PREFIX=/api/v1
FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
CORS_ORIGINS=https://your-vercel-app.vercel.app
POSTGRES_USER=sherlock_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sherlock_db
POSTGRES_READONLY_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://sherlock_admin:change_me@postgres:5432/sherlock_db
READONLY_DATABASE_URL=postgresql+psycopg://sherlock_readonly:change_me@postgres:5432/sherlock_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=https://your-vercel-app.vercel.app
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_TOKENS=2048
UPLOAD_TMP_DIR=.tmp/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=26214400
UPLOAD_MAX_COLUMNS=100
UPLOAD_SESSION_TTL_MINUTES=30
